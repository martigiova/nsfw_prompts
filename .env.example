# RunPod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_DATA_CENTER_ID=
# ComfyUI + CUDA only (~10 GB). MiniMax weights stay on the Network Volume.
DOCKER_IMAGE=ls250824/run-comfyui-minimax:08092026
CONTAINER_DISK_GB=30
BOOTSTRAP_REPO=https://github.com/martigiova/nsfw_prompts.git
GIT_REF=cursor/minimax-runpod-serverless-9e74
CONFIRM_BOOTSTRAP=0

# Hugging Face (solo se un repo e gated)
HF_TOKEN=

# OpenRouter: solo se auto_prompt=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Minimax
AIRTABLE_PROMPT_FIELD=Prompt
AIRTABLE_IMAGE_FIELD=Image
AIRTABLE_VIDEO_FIELD=Video
AIRTABLE_AUDIO_FIELD=Audio
AIRTABLE_DURATION_FIELD=Duration
AIRTABLE_ASPECT_FIELD=Aspect
AIRTABLE_AUTO_PROMPT_FIELD=Auto Prompt
AIRTABLE_STATUS_FIELD=Status
AIRTABLE_OUTPUT_FIELD=Output
AIRTABLE_ERROR_FIELD=Errore
AIRTABLE_JOB_ID_FIELD="Job ID"

# S3 / R2 obbligatorio per allegare il video su Airtable (i mp4 superano i 5 MB)
BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
BUCKET_NAME=
BUCKET_PUBLIC_URL_PREFIX=

# Worker — 1080p on MiniMax's 32px grid (9:16 → 1088×1920). Needs RTX PRO 6000.
VIDEO_MEGAPIXELS=2.08896
COMFY_INPUT_DIR=/ComfyUI/input
COMFY_OUTPUT_DIR=/ComfyUI/output
WORKFLOW_PATH=/app/workflows/api_template.json
MOTION_LORA_NAME=hmmotion_minimax-h3_epoch40.safetensors
SKIP_MOTION_LORA=1
SKIP_VOLUME_CHECK=0
COMFY_WAIT_TIMEOUT=1650
REFRESH_WORKER=false
